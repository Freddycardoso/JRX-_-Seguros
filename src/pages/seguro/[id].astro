---
import Layout from '@/src/layouts/Layout.astro';
import {
  Shield,
  ArrowLeft,
  ArrowDown,
  ChevronRight,
  ShieldCheck,
  CheckCircle2,
  Sparkles,
} from 'lucide-react';
import { segurosData, type SeguroItem } from '@/src/data/seguros';
import { SITE_CONFIG } from '@/src/config/site';
import { WhatsAppCTA } from '@/src/components/WhatsAppCTA';
import { FAQAccordion } from '@/src/components/FAQAccordion';
import { DynamicIcon } from '@/src/components/DynamicIcon';
import { MotionReveal } from '@/src/components/MotionReveal';

export function getStaticPaths() {
  return segurosData.map((s) => ({
    params: { id: s.id },
    props: { seguro: s },
  }));
}

interface Props {
  seguro: SeguroItem;
}

const { id } = Astro.params;
const { seguro = segurosData.find((item) => item.id === id || item.slug === id)! } = Astro.props;

if (!seguro) {
  return Astro.redirect('/404');
}

const seguroJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FinancialProduct',
  name: seguro.nome,
  description: seguro.descricao,
  provider: {
    '@type': 'InsuranceAgency',
    name: 'JRX Seguros',
    telephone: '+55-35-99154-5108',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Rua dos Brandões, 231, Sala 30',
      addressLocality: 'Passos',
      addressRegion: 'MG',
      addressCountry: 'BR',
    },
  },
  offers: {
    '@type': 'Offer',
    price: '0.00',
    priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock',
  },
};
---

<Layout
  title={`${seguro.nome} | JRX Seguros Unidade Passos - MG`}
  description={`${seguro.titulo} ${seguro.descricao} Faça sua cotação rápida no WhatsApp da JRX Seguros.`}
  canonical={`/seguro/${seguro.id}`}
  ogImage={seguro.imagemUrl}
  productName={seguro.nome}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(seguroJsonLd)} />
    <link rel="preload" as="image" href={seguro.imagemUrl} fetchpriority="high" />
  </Fragment>

  <div class="flex flex-col w-full bg-[#050E1D] text-slate-100 selection:bg-sky-500/30 selection:text-sky-200">
    <!-- ========================================================================= -->
    <!-- BREADCRUMB EDITORIAL                                                      -->
    <!-- ========================================================================= -->
    <nav class="bg-[#050E1D] border-b border-white/[0.06] py-2.5 sm:py-3.5 relative z-10 transition-colors" aria-label="Navegação breadcrumb">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <ol class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs text-slate-400 overflow-x-auto whitespace-nowrap py-0.5">
          <li>
            <a href="/" class="hover:text-white transition-colors flex items-center gap-1.5 font-medium shrink-0">
              <ArrowLeft className="w-3.5 h-3.5 text-slate-500" aria-hidden="true" />
              <span>Início</span>
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-600 shrink-0">/</li>
          <li class="shrink-0">
            <a href="/#nossos-seguros" class="hover:text-white transition-colors font-medium">
              Seguros
            </a>
          </li>
          <li aria-hidden="true" class="text-slate-600 shrink-0">/</li>
          <li aria-current="page" class="shrink-0">
            <span class="font-medium text-white">{seguro.nome}</span>
          </li>
        </ol>
      </div>
    </nav>

    <!-- ========================================================================= -->
    <!-- 1. HERO ESPECÍFICO DO SEGURO (Awwwards-Tier Cover & Emil Kowalski Craft)    -->
    <!-- ========================================================================= -->
    <section class="relative overflow-hidden bg-[#050E1D] text-white pt-10 sm:pt-20 lg:pt-28 pb-14 sm:pb-20 border-b border-white/[0.08]">
      {/* Iluminação Atmosférica & Backdrop Cinematográfico */}
      <div class="absolute inset-0 z-0 select-none pointer-events-none overflow-hidden">
        <img
          src={seguro.imagemUrl}
          alt={`Cenário visual para ${seguro.nome}`}
          class="w-full h-full object-cover object-center opacity-25 filter saturate-[1.1] scale-105 transition-transform duration-1000 ease-[cubic-bezier(0.23,1,0.32,1)]"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        {/* Camadas de Difusão Gradual */}
        <div class="absolute inset-0 bg-gradient-to-r from-[#050E1D] via-[#050E1D]/90 to-[#050E1D]/70"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#050E1D] via-[#050E1D]/60 to-transparent"></div>
        <div class="absolute -top-32 right-1/4 w-96 h-96 bg-sky-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-24 left-1/4 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-12 lg:gap-16 items-center">
          
          <!-- Coluna Esquerda: Conteúdo Estratégico & Ação Exploratória -->
          <div class="lg:col-span-7 space-y-5 sm:space-y-6 text-center lg:text-left">
            <MotionReveal client:visible delay={0.05}>
              <div class="mb-5 sm:mb-6">
                <div class="inline-flex items-center flex-wrap justify-center gap-2 px-4 py-1.5 rounded-full bg-white/[0.06] border border-white/10 backdrop-blur-md text-[10px] sm:text-[11px] font-medium tracking-wider uppercase text-sky-300 max-w-full shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
                  <span>{seguro.category}</span>
                  <span class="text-sky-300/40">·</span>
                  <span>{seguro.badge}</span>
                </div>
              </div>
            </MotionReveal>

            <MotionReveal client:visible delay={0.1}>
              <h1 class="text-2xl sm:text-4xl lg:text-5xl font-bold sm:font-extrabold tracking-normal sm:tracking-tight text-white leading-[1.28] sm:leading-[1.18] lg:leading-[1.12] text-balance mt-2 sm:mt-3">
                {seguro.heroHeadline || seguro.titulo}
              </h1>
            </MotionReveal>

            <MotionReveal client:visible delay={0.15}>
              <p class="text-sm sm:text-base lg:text-lg text-slate-200/90 leading-relaxed max-w-xl mx-auto lg:mx-0 font-normal text-balance mt-3 sm:mt-4">
                {seguro.heroSubheadline || seguro.descricao}
              </p>
            </MotionReveal>

            <!-- Ação Exploratória (Emil Kowalski Button-in-Button - Sem excesso de WhatsApp no Topo) -->
            <MotionReveal client:visible delay={0.2}>
              <div class="pt-3 flex flex-col sm:flex-row items-center gap-3.5 sm:gap-4 justify-center lg:justify-start">
                <a
                  href="#vantagens"
                  class="group inline-flex items-center justify-between sm:justify-start gap-3.5 pl-5 pr-2 py-2 sm:pl-6 sm:pr-2.5 sm:py-2.5 rounded-full bg-white hover:bg-sky-400 text-black font-semibold text-xs sm:text-sm transition-all duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] shadow-[0_4px_24px_rgba(255,255,255,0.12)] hover:shadow-[0_8px_32px_rgba(56,189,248,0.4)] active:scale-[0.97] w-full sm:w-auto"
                >
                  <span class="mx-auto sm:mx-0">Explorar Diretrizes &amp; Coberturas</span>
                  <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-black/10 flex items-center justify-center group-hover:translate-y-0.5 transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)] shrink-0">
                    <ArrowDown className="w-3.5 h-3.5 text-black" aria-hidden="true" />
                  </span>
                </a>

                <div class="inline-flex items-center justify-center gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-full bg-white/[0.04] border border-white/10 backdrop-blur-sm text-[11px] sm:text-xs text-slate-300 w-full sm:w-auto">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                  </span>
                  <span class="font-medium text-slate-300">Assessoria Técnica Independente</span>
                </div>
              </div>

              <!-- Marcadores de Confiança Executiva -->
              <div class="pt-5 sm:pt-6 flex flex-wrap items-center justify-center lg:justify-start gap-y-2 gap-x-4 sm:gap-x-6 text-[11px] sm:text-xs font-medium text-slate-400">
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <span class="text-sky-400 text-xs">●</span>
                  <span>Curadoria Multisseguradoras</span>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <span class="text-sky-400 text-xs">●</span>
                  <span>Apoio Direto em Sinistro com Sócios</span>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2">
                  <span class="text-sky-400 text-xs">●</span>
                  <span>Passos - MG &amp; Atendimento Nacional</span>
                </div>
              </div>
            </MotionReveal>
          </div>

          <!-- Coluna Direita: Double-Bezel Hardware Showcase (Dossiê Estratégico) -->
          <MotionReveal client:visible delay={0.15} className="lg:col-span-5 flex justify-center">
            <div class="w-full max-w-md p-2.5 rounded-[2.25rem] bg-gradient-to-b from-white/[0.1] to-white/[0.02] border border-white/10 shadow-[0_30px_80px_-20px_rgba(2,6,23,0.95)]">
              <div class="rounded-[calc(2.25rem-0.625rem)] bg-[#07162C]/95 border border-sky-400/20 shadow-[inset_0_1px_1px_rgba(255,255,255,0.15)] overflow-hidden">
                <!-- Imagem em Destaque com Moldura Elegante -->
                <div class="relative aspect-[16/10] w-full overflow-hidden">
                  <img
                    src={seguro.imagemUrl}
                    alt={`Ilustração representativa do ${seguro.nome}`}
                    class="w-full h-full object-cover object-center"
                    loading="eager"
                    decoding="async"
                    fetchpriority="high"
                    width="448"
                    height="280"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#07162C] via-transparent to-transparent"></div>
                  <span class="absolute top-3.5 right-3.5 px-3 py-1 rounded-full text-[10px] font-medium uppercase tracking-[0.16em] bg-slate-950/85 text-sky-300 backdrop-blur-md border border-white/10">
                    Análise Consultiva
                  </span>
                  <div class="absolute bottom-3 left-4">
                    <span class="text-xs font-semibold text-white tracking-wide drop-shadow-md">
                      {seguro.nome}
                    </span>
                  </div>
                </div>

                <!-- Corpo do Dossiê Executivo -->
                <div class="p-6 sm:p-7 space-y-5">
                  <div>
                    <span class="text-[10px] font-medium uppercase tracking-[0.18em] text-slate-400 block mb-1.5">
                      PERFIL ESTRATÉGICO INDICADO
                    </span>
                    <h3 class="text-sm sm:text-base font-semibold text-slate-200 leading-snug">
                      {seguro.idealFor}
                    </h3>
                  </div>

                  <!-- Métricas de Contratação -->
                  <div class="space-y-2.5 pt-4 border-t border-slate-800/80 text-xs">
                    <div class="flex items-center justify-between text-slate-300">
                      <span class="text-slate-400">Estruturação:</span>
                      <span class="font-medium text-slate-200">Sob medida para suas necessidades</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-300">
                      <span class="text-slate-400">Consultores Titulares:</span>
                      <span class="font-medium text-white">Paulo Martins &amp; André</span>
                    </div>
                    <div class="flex items-center justify-between text-slate-300">
                      <span class="text-slate-400">Agilidade de Diagnóstico:</span>
                      <span class="font-medium text-emerald-400">Comparativo Rápido e Sem Custo</span>
                    </div>
                  </div>

                  <!-- Acesso Direto às Coberturas -->
                  <div class="pt-2">
                    <a
                      href="#coberturas"
                      class="group flex items-center justify-between p-3.5 rounded-xl bg-white/[0.03] hover:bg-white/[0.07] border border-white/[0.08] hover:border-sky-400/40 transition-all duration-300 text-xs font-medium text-slate-200"
                    >
                      <span class="flex items-center gap-2">
                        <ShieldCheck className="w-4 h-4 text-sky-400" />
                        <span>Ver todas as {seguro.coverageHighlights.length} coberturas incluídas</span>
                      </span>
                      <ChevronRight className="w-4 h-4 text-slate-400 group-hover:text-white group-hover:translate-x-0.5 transition-transform" />
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </MotionReveal>

        </div>

        <!-- ===================================================================== -->
        <!-- TRANSIÇÃO SUAVE PARA O CONTEÚDO (Emil Kowalski Smooth Scroll Indicator) -->
        <!-- ===================================================================== -->
        <div class="mt-16 sm:mt-20 pt-8 border-t border-white/[0.06] flex flex-col items-center justify-center text-center">
          <a
            href="#vantagens"
            class="group inline-flex flex-col items-center gap-2 text-slate-400 hover:text-white transition-colors duration-300"
            aria-label="Conhecer vantagens e coberturas"
          >
            <span class="text-[10px] font-medium uppercase tracking-[0.2em] text-slate-400 group-hover:text-sky-300 transition-colors">
              Conheça as vantagens e coberturas
            </span>
            <div class="w-7 h-11 rounded-full border border-white/20 flex items-start justify-center p-1.5 bg-white/[0.02] group-hover:border-sky-400/50 group-hover:bg-white/[0.06] transition-all">
              <div class="w-1.5 h-2.5 rounded-full bg-sky-400 animate-pulse"></div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. BENEFÍCIOS ESSENCIAIS (Grade Editorial com Divisórias Sutis)           -->
    <!-- ========================================================================= -->
    <section id="vantagens" class="py-24 sm:py-28 bg-[#070B14] border-b border-slate-800/80 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <MotionReveal client:visible>
          <div class="max-w-3xl mb-14 sm:mb-16">
            <span class="inline-block text-xs font-medium uppercase tracking-wider text-slate-300 bg-white/5 border border-white/10 px-3.5 py-1 rounded-full mb-4">
              VANTAGENS ESTRATÉGICAS
            </span>
            <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold text-white tracking-normal sm:tracking-tight leading-snug sm:leading-tight mb-4">
              Por que contratar o <span class="italic font-serif text-sky-400">{seguro.nome}</span>?
            </h2>
            <p class="text-sm sm:text-base text-slate-400 leading-relaxed font-normal">
              Proteção abrangente estruturada sem jargões para você saber exatamente o que está coberto.
            </p>
          </div>
        </MotionReveal>

        {/* Grade Editorial de 3 Colunas com Divisórias Sutis */}
        <MotionReveal client:visible delay={0.1}>
          <div class="grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-800/80 border-t border-b border-slate-800/80">
            {seguro.benefitsDetails.map((benefit, index) => {
              const num = String(index + 1).padStart(2, '0');
              return (
                <div class="p-8 sm:p-10 flex flex-col justify-between h-full hover:bg-slate-900/30 transition-colors duration-300 group">
                  <div>
                    <div class="flex items-center justify-between mb-6">
                      <span class="text-sm text-slate-500 font-medium tracking-normal block">
                        {num}
                      </span>
                      <div class="w-10 h-10 rounded-xl bg-white/[0.04] border border-white/10 flex items-center justify-center text-sky-300 group-hover:scale-105 group-hover:text-white transition-all duration-300">
                        <DynamicIcon name={benefit.iconName} className="w-5 h-5" />
                      </div>
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight mb-2.5">
                      {benefit.title}
                    </h3>
                    <p class="text-sm text-slate-400 leading-relaxed font-normal">
                      {benefit.description}
                    </p>
                  </div>

                  <div class="pt-6 mt-8 border-t border-slate-800/60">
                    <span class="text-xs font-medium text-slate-400 flex items-center gap-2">
                      <span class="text-sky-400 text-xs">●</span>
                      <span>Consultoria e suporte inclusos</span>
                    </span>
                  </div>
                </div>
              );
            })}
          </div>
        </MotionReveal>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 3. COBERTURAS E PROTEÇÕES INCLUSAS (Painel Double-Bezel)                  -->
    <!-- ========================================================================= -->
    <section id="coberturas" class="py-20 sm:py-28 bg-[#061224] border-b border-slate-800/80 relative">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <MotionReveal client:visible>
          <div class="p-2 rounded-[2rem] bg-white/[0.03] border border-slate-800/80 shadow-[0_20px_50px_rgba(2,6,23,0.85)]">
            <div class="rounded-[calc(2rem-0.5rem)] bg-[#07162E]/90 border border-sky-400/20 p-7 sm:p-10 lg:p-12 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)]">
              
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 mb-8 pb-6 border-b border-slate-800/80">
                <div>
                  <span class="inline-block text-xs font-medium uppercase tracking-wider text-slate-300 bg-white/5 border border-white/10 px-3 py-1 rounded-full mb-3">
                    PROTEÇÃO INTEGRAL
                  </span>
                  <h3 class="text-xl sm:text-3xl font-bold text-white tracking-normal sm:tracking-tight leading-snug">
                    O que está coberto no <span class="italic font-serif text-sky-400">{seguro.nome}</span>
                  </h3>
                </div>
                <WhatsAppCTA
                  client:load
                  productName={seguro.nome}
                  label="Verificar Coberturas no WhatsApp"
                  size="sm"
                  variant="whatsapp"
                  fullWidthMobile={false}
                  className="font-semibold shadow-lg shadow-emerald-950/40"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                {seguro.coverageHighlights.map((highlight) => (
                  <div
                    class="flex items-center gap-3.5 p-4 rounded-xl bg-white/[0.03] border border-white/[0.07] hover:border-sky-400/30 hover:bg-white/[0.05] transition-colors"
                  >
                    <ShieldCheck className="w-5 h-5 text-emerald-400 shrink-0" aria-hidden="true" />
                    <span class="text-sm font-medium text-slate-200">
                      {highlight}
                    </span>
                  </div>
                ))}
              </div>

            </div>
          </div>
        </MotionReveal>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. PERGUNTAS FREQUENTES                                                   -->
    <!-- ========================================================================= -->
    <FAQAccordion
      client:visible
      items={seguro.faqs}
      title={`Perguntas Frequentes sobre ${seguro.nome}`}
      subtitle="Esclareça suas dúvidas para contratar com total segurança"
      productName={seguro.nome}
    />

    <!-- ========================================================================= -->
    <!-- 5. CTA FINAL (Fechamento Executivo)                                       -->
    <!-- ========================================================================= -->
    <section class="relative overflow-hidden bg-[#070B14] text-white py-24 sm:py-32 border-t border-slate-800/80 min-h-[460px] flex items-center">
      <div class="absolute inset-0 z-0 select-none pointer-events-none">
        <img
          src={seguro.imagemUrl}
          alt="Fundo representativo para CTA"
          class="w-full h-full object-cover object-center opacity-10"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#070B14] via-[#070B14]/85 to-transparent"></div>
      </div>

      <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 z-10">
        <MotionReveal client:visible>
          <span class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-300 bg-white/5 border border-white/10 px-3.5 py-1 rounded-full mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Unidade Passos - MG · Atendimento Nacional</span>
          </span>

          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-bold tracking-normal sm:tracking-tight text-white leading-snug sm:leading-tight text-balance max-w-3xl mx-auto mt-2 mb-4">
            Cote agora o <span class="italic font-serif text-sky-400">{seguro.nome}</span> com um consultor especialista
          </h2>

          <p class="text-base sm:text-lg text-slate-400 max-w-xl mx-auto leading-relaxed font-normal mb-8">
            Receba uma análise detalhada com as melhores condições e coberturas das principais seguradoras.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-full px-2">
            <div class="w-full max-w-md mx-auto">
              <WhatsAppCTA
                client:load
                productName={seguro.nome}
                label={`Solicitar Cotação · ${seguro.nome}`}
                size="lg"
                variant="whatsapp"
                showSubtitle={true}
                className="w-full shadow-2xl shadow-emerald-950/60 font-semibold text-center"
              />
            </div>
          </div>

          <div class="pt-8">
            <a
              href="/#nossos-seguros"
              class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-wider text-slate-400 hover:text-sky-300 transition-colors"
            >
              <span>Ver todos os outros ramos de seguros da JRX</span>
              <ChevronRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </MotionReveal>
      </div>
    </section>
  </div>
</Layout>
