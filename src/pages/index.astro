---
import Layout from '@/src/layouts/Layout.astro';
import {
  HeartHandshake,
  Headphones,
  Building2,
  Shield,
  ChevronRight,
  MessageSquare,
  Search,
  FileCheck,
  LifeBuoy,
  PhoneCall,
  Clock,
  Sparkles,
} from 'lucide-react';
import { type FaqItem } from '@/src/data/seguros';
import { SITE_CONFIG } from '@/src/config/site';
import { FAQAccordion } from '@/src/components/FAQAccordion';
import { SegurosCarousel } from '@/src/components/SegurosCarousel';
import { MotionReveal } from '@/src/components/MotionReveal';
import { WhatsAppCTA } from '@/src/components/WhatsAppCTA';

const PARTNER_INSURERS = [
  'Porto Seguro',
  'Azul Seguros',
  'Tokio Marine',
  'Allianz',
  'Bradesco Seguros',
  'SulAmérica',
  'HDI Seguros',
  'Mapfre',
  'Sompo Seguros',
  'Zurich',
];

const HOME_FAQS: FaqItem[] = [
  {
    question: 'Como funciona a cotação de seguros pelo WhatsApp da JRX Seguros?',
    answer:
      'A cotação é 100% digital e sem burocracia: ao clicar em nosso botão de WhatsApp, você conversa diretamente com os consultores especializados Paulo Martins ou André. Você informa os dados básicos do seu veículo, patrimônio ou empresa, e nossa equipe analisa suas necessidades reais para apresentar as melhores opções em poucos minutos.',
  },
  {
    question: 'Como recebo o estudo comparativo das seguradoras?',
    answer:
      'Nossa equipe elabora e envia uma tabela comparativa detalhada diretamente no seu WhatsApp. Nela, você visualiza lado a lado os preços, valores de franquia e coberturas das principais companhias do Brasil, podendo tirar dúvidas técnicas de forma transparente antes de decidir qual plano melhor atende à sua família ou empresa.',
  },
  {
    question: 'A JRX Seguros atende apenas em Passos - MG ou em outras cidades?',
    answer:
      'Nossa sede física está localizada na Rua dos Brandões, 231, Sala 30, em Passos - MG. No entanto, prestamos consultoria, emitimos apólices e oferecemos gestão completa de riscos para clientes, produtores rurais e empresas em todo o Sudoeste Mineiro e em qualquer estado do território nacional com atendimento 100% humanizado.',
  },
  {
    question: 'O que devo fazer caso ocorra uma colisão, pane ou sinistro?',
    answer:
      'Você nunca fica desamparado em filas de centrais telefônicas: basta acionar imediatamente a JRX Seguros pelo WhatsApp. Nossos consultores orientam os primeiros procedimentos no local, acionam guincho e serviços emergenciais 24h e acompanham todo o processo pericial e documental até a conclusão e o pagamento da indenização pela seguradora.',
  },
  {
    question: 'Existe algum custo para realizar a cotação e auditoria de apólice?',
    answer:
      'Nenhum custo. O estudo de mercado, a análise comparativa entre as melhores seguradoras e a auditoria de apólices vigentes são serviços inteiramente gratuitos e sem qualquer compromisso de contratação. Nosso objetivo é garantir que você pague estritamente pelo que necessita, com máxima transparência e segurança jurídica.',
  },
  {
    question: 'Com quais seguradoras a JRX Seguros trabalha?',
    answer:
      'Trabalhamos em parceria com as 10 maiores e mais sólidas companhias seguradoras do país, incluindo Porto Seguro, Azul Seguros, Tokio Marine, Allianz, Bradesco Seguros, SulAmérica, Mapfre, HDI Seguros, Sompo e Zurich. Essa ampla atuação multimercado garante total independência e imparcialidade na recomendação da melhor apólice para você.',
  },
];

const homeJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'InsuranceAgency',
      '@id': 'https://jrxseguros.com.br/#organization',
      name: 'JRX Seguros',
      legalName: 'JRX Consultoria e Corretagem de Seguros Ltda',
      alternateName: ['JRX Seguros Passos', 'JRX Seguros Unidade Passos', 'JRX Corretora de Seguros'],
      description:
        'Corretora e assessoria independente de seguros em Passos - MG e Sudoeste Mineiro. Cotação rápida via WhatsApp para seguro auto, empresarial, residencial, agro e vida com as 10 maiores seguradoras.',
      url: 'https://jrxseguros.com.br',
      logo: 'https://jrxseguros.com.br/logo-jrx.png',
      image: 'https://jrxseguros.com.br/og-image.jpg',
      telephone: '+55-35-99154-5108',
      email: SITE_CONFIG.email,
      taxID: SITE_CONFIG.cnpj,
      priceRange: '$$',
      currenciesAccepted: 'BRL',
      paymentAccepted: 'Boleto Bancário, Cartão de Crédito, Débito em Conta, Pix',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Rua dos Brandões, 231, Sala 30',
        addressLocality: 'Passos',
        addressRegion: 'MG',
        postalCode: '37900-118',
        addressCountry: 'BR',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: -20.7188,
        longitude: -46.6097,
      },
      openingHoursSpecification: [
        {
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
          opens: '08:00',
          closes: '17:00',
        },
      ],
      areaServed: [
        {
          '@type': 'City',
          name: 'Passos',
          sameAs: 'https://pt.wikipedia.org/wiki/Passos_(Minas_Gerais)',
        },
        {
          '@type': 'AdministrativeArea',
          name: 'Sudoeste Mineiro',
        },
        {
          '@type': 'Country',
          name: 'Brasil',
        },
      ],
      founder: [
        {
          '@type': 'Person',
          name: 'Paulo Martins',
          jobTitle: 'Consultor Especialista em Riscos e Seguros',
          telephone: '+55-35-99154-5108',
        },
        {
          '@type': 'Person',
          name: 'André',
          jobTitle: 'Consultor Especialista em Riscos e Seguros',
          telephone: '+55-35-98835-7944',
        },
      ],
      employee: [
        {
          '@type': 'Person',
          name: 'Paulo Martins',
          jobTitle: 'Consultor Especialista em Riscos e Seguros',
        },
        {
          '@type': 'Person',
          name: 'André',
          jobTitle: 'Consultor Especialista em Riscos e Seguros',
        },
      ],
      knowsAbout: [
        'Seguro Automóvel',
        'Seguro de Vida',
        'Seguro Residencial',
        'Seguro Empresarial',
        'Máquinas Agrícolas',
        'Seguro Fotovoltaico',
        'Planos de Saúde',
        'Seguro Viagem',
        'Fiança Locatícia',
        'Consórcios',
        'Seguro de Moto',
      ],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Catálogo de Seguros e Proteção Patrimonial JRX',
        itemListElement: [
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Seguro Automóvel em Passos - MG',
              description: 'Proteção contra colisão, roubo, furto, danos a terceiros com guincho 24h e cobertura para vidros.',
              url: 'https://jrxseguros.com.br/seguro/automovel',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Seguro de Vida e Proteção Familiar',
              description: 'Amparo financeiro imediato sem inventário, indenização em vida para diagnóstico de doenças graves e invalidez.',
              url: 'https://jrxseguros.com.br/seguro/vida',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Seguro Agrícola e Máquinas no Sudoeste Mineiro',
              description: 'Proteção para tratores, colheitadeiras e implementos agrícolas operando no campo contra tombamento, raio e incêndio.',
              url: 'https://jrxseguros.com.br/seguro/maquinas-agricolas',
            },
          },
          {
            '@type': 'Offer',
            itemOffered: {
              '@type': 'Service',
              name: 'Seguro Empresarial e Patrimonial',
              description: 'Blindagem corporativa cobrindo estoque, prédios, responsabilidade civil e lucros cessantes.',
              url: 'https://jrxseguros.com.br/seguro/empresarial',
            },
          },
        ],
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://jrxseguros.com.br/#website',
      url: 'https://jrxseguros.com.br',
      name: 'JRX Seguros',
      publisher: {
        '@id': 'https://jrxseguros.com.br/#organization',
      },
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://jrxseguros.com.br/#webpage',
      url: 'https://jrxseguros.com.br',
      name: 'JRX Seguros | Corretora de Seguros em Passos - MG',
      isPartOf: {
        '@id': 'https://jrxseguros.com.br/#website',
      },
      about: {
        '@id': 'https://jrxseguros.com.br/#organization',
      },
      description:
        'Corretora de seguros em Passos - MG. Cotação rápida via WhatsApp com Paulo Martins e André. Comparativo entre Porto Seguro, Tokio Marine, Allianz e Bradesco.',
      inLanguage: 'pt-BR',
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://jrxseguros.com.br/#faq',
      mainEntity: HOME_FAQS.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    },
  ],
};
---

<Layout
  title="JRX Seguros | Consultoria Patrimonial e Gestão de Riscos"
  description="Consultoria em seguros em Passos - MG. Cotação ágil via WhatsApp para Seguro de Vida, Auto, Agro, Residencial e Empresarial com atendimento humano e imparcial."
  canonical="/"
  ogImage="/og-image.jpg"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homeJsonLd)} />
    <!-- Preload do recurso LCP Crítico da Página Inicial -->
    <link rel="preload" as="image" href="/hero-casa-luxo.webp" type="image/webp" fetchpriority="high" />
  </Fragment>

  <div class="flex flex-col w-full bg-[#061224] text-slate-100 relative overflow-hidden">
    {/* Fundo com Textura Sutil de Ruído e Brilhos Radiais de Profundidade */}
    <div class="fixed inset-0 bg-noise z-40 pointer-events-none opacity-20"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[700px] bg-[radial-gradient(ellipse_at_top,rgba(2,132,199,0.22),transparent_70%)] pointer-events-none -z-10"></div>
    <div class="absolute top-[850px] right-0 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(30,58,138,0.18),transparent_70%)] pointer-events-none -z-10"></div>
    <div class="absolute top-[1700px] left-0 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(14,116,144,0.15),transparent_70%)] pointer-events-none -z-10"></div>

    <!-- ========================================================================= -->
    <!-- 1. HERO SECTION: Grandioso, com Espaço, Respiro e Destaque aos Consultores -->
    <!-- ========================================================================= -->
    <section class="relative overflow-hidden pt-16 pb-20 sm:pt-20 sm:pb-24 lg:pt-24 lg:pb-32 min-h-[660px] lg:min-h-[740px] flex items-center">
      {/* Fundo Arquitetônico com Máscara Escura (Recurso LCP Otimizado) */}
      <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none opacity-[0.10]">
        <img
          src="/hero-casa-luxo.webp"
          alt="Residência de alto padrão protegida pela consultoria JRX Seguros"
          class="w-full h-full object-cover object-center grayscale"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="1920"
          height="1080"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#061224] via-[#061224]/85 to-[#061224]"></div>
      </div>

      {/* Corretor André (Posicionado com generoso respiro no topo) */}
      <div class="hidden lg:block absolute bottom-0 left-[2%] xl:left-[6%] w-[310px] xl:w-[360px] z-10 select-none pointer-events-none drop-shadow-[0_20px_40px_rgba(0,0,0,0.9)]">
        <div class="relative">
          <img
            src="/corretor-paulo-nobg.webp"
            alt="André - Consultor Especialista da JRX Seguros"
            width="360"
            height="530"
            class="w-full h-auto object-contain object-bottom opacity-90"
            loading="eager"
            decoding="async"
            style="max-height: 530px; mask-image: linear-gradient(to top, transparent 0%, black 22%); -webkit-mask-image: linear-gradient(to top, transparent 0%, black 22%);"
          />
          {/* Badge de Identificação */}
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-[#091D3E]/90 backdrop-blur-md border border-sky-400/30 px-3.5 py-1.5 rounded-full text-center shadow-lg whitespace-nowrap">
            <span class="text-xs font-bold text-white block">André</span>
            <span class="text-[10px] text-sky-300 font-medium">Consultor Especialista</span>
          </div>
        </div>
      </div>

      {/* Corretor Paulo Martins (Posicionado com generoso respiro no topo) */}
      <div class="hidden lg:block absolute bottom-0 right-[2%] xl:right-[6%] w-[300px] xl:w-[350px] z-10 select-none pointer-events-none drop-shadow-[0_20px_40px_rgba(0,0,0,0.9)]">
        <div class="relative">
          <img
            src="/corretor-andre-nobg.webp"
            alt="Paulo Martins - Consultor Especialista da JRX Seguros"
            width="350"
            height="530"
            class="w-full h-auto object-contain object-bottom transform -scale-x-100 opacity-90"
            loading="eager"
            decoding="async"
            style="max-height: 530px; mask-image: linear-gradient(to top, transparent 0%, black 22%); -webkit-mask-image: linear-gradient(to top, transparent 0%, black 22%);"
          />
          {/* Badge de Identificação */}
          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 bg-[#091D3E]/90 backdrop-blur-md border border-sky-400/30 px-3.5 py-1.5 rounded-full text-center shadow-lg whitespace-nowrap">
            <span class="text-xs font-bold text-white block">Paulo Martins</span>
            <span class="text-[10px] text-sky-300 font-medium">Consultor Especialista</span>
          </div>
        </div>
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full z-20">
        <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
          
          <MotionReveal client:visible delay={0.05}>
            <div class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full border border-sky-400/30 bg-[#091D3E]/80 backdrop-blur-xl shadow-[0_0_20px_rgba(56,189,248,0.18)] mb-6">
              <span class="flex h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span class="text-xs font-bold uppercase tracking-[0.14em] text-sky-300">
                Corretora de Seguros em Passos - MG · Atendimento Regional &amp; Nacional
              </span>
            </div>
          </MotionReveal>

          <MotionReveal client:visible delay={0.1}>
            <h1 class="text-3xl sm:text-5xl lg:text-[3.9rem] font-extrabold tracking-tight text-white leading-[1.08] mb-6 text-balance">
              Corretora de Seguros em Passos - MG: <span class="text-sky-400 italic font-serif">Proteção Inteligente</span> para Veículos, Família e Negócios.
            </h1>
          </MotionReveal>

          <MotionReveal client:visible delay={0.15}>
            <p class="text-base sm:text-lg text-slate-200/95 leading-relaxed max-w-2xl mx-auto font-normal mb-7">
              A <strong>JRX Seguros</strong> compara apólices nas maiores companhias do Brasil (Porto Seguro, Tokio Marine, Allianz e Bradesco) para entregar o melhor custo-benefício. Atendimento humanizado direto no WhatsApp com os consultores <strong>Paulo Martins</strong> e <strong>André</strong>, sem robôs ou esperas.
            </p>
          </MotionReveal>

          {/* Destaques Rápidos em Lista Não-Ordenada (AEO Featured Snippets) */}
          <MotionReveal client:visible delay={0.18}>
            <ul class="flex flex-wrap items-center justify-center gap-3 sm:gap-6 text-xs sm:text-sm text-slate-300 mb-8 list-none p-0">
              <li class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Cotação comparativa em 2 minutos</span>
              </li>
              <li class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Suporte presencial em sinistros</span>
              </li>
              <li class="flex items-center gap-1.5 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                <span class="text-emerald-400 font-bold">✓</span>
                <span>Rua dos Brandões, 231 · Passos</span>
              </li>
            </ul>
          </MotionReveal>

          <MotionReveal client:visible delay={0.2}>
            <div class="flex flex-col items-center justify-center gap-3">
              <WhatsAppCTA
                client:load
                productName="Geral"
                label="Cotar Agora pelo WhatsApp"
                size="lg"
                variant="whatsapp"
                fullWidthMobile={true}
                className="btn-press shadow-[0_16px_36px_rgba(16,185,129,0.38)] !px-10 !py-4 text-base font-bold"
              />
              <span class="text-xs text-slate-400 flex items-center gap-1.5 pt-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                Tempo médio de resposta: <strong class="text-slate-200">menos de 3 minutos</strong> · Atendimento 100% humano
              </span>
            </div>

            {/* Apresentação Humana Compacta no Mobile */}
            <div class="lg:hidden flex items-center justify-center gap-3.5 mt-8 pt-6 border-t border-sky-400/15">
              <div class="flex items-center -space-x-3">
                <img
                  src="/corretor-andre-nobg.webp"
                  alt="Paulo Martins"
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class="w-11 h-11 rounded-full object-cover object-top border-2 border-sky-400/40 bg-[#091D3E]"
                />
                <img
                  src="/corretor-paulo-nobg.webp"
                  alt="André"
                  width="44"
                  height="44"
                  loading="lazy"
                  decoding="async"
                  class="w-11 h-11 rounded-full object-cover object-top border-2 border-sky-400/40 bg-[#091D3E]"
                />
              </div>
              <div class="text-left">
                <div class="text-xs font-bold text-white">Paulo Martins &amp; André</div>
                <div class="text-[11px] text-sky-300">Consultores dedicados no WhatsApp</div>
              </div>
            </div>
          </MotionReveal>
        </div>
      </div>
    </section>

    <!-- ========================================================================= -->
    <!-- 2. LOGOS DE SEGURADORAS PARCEIRAS (Trust Signals Oficiais)                -->
    <!-- ========================================================================= -->
    <MotionReveal client:visible>
      <section class="py-8 sm:py-10 border-y border-sky-400/10 bg-[#07172E]/60 my-4" aria-label="Seguradoras parceiras">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-sky-400/70 mb-6">
            Trabalhamos com as Principais e Mais Sólidas Seguradoras do País
          </p>
          <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-slate-300/80">
            {PARTNER_INSURERS.map((insurer) => (
              <div
                class="text-xs sm:text-sm font-bold tracking-tight hover:text-white hover:scale-105 transition-all duration-300 py-1 cursor-default"
              >
                {insurer}
              </div>
            ))}
          </div>
        </div>
      </section>
    </MotionReveal>

    <!-- ========================================================================= -->
    <!-- 3. SEÇÃO NOSSOS SEGUROS (Carrossel dos 11 Ramos)                          -->
    <!-- ========================================================================= -->
    <section id="nossos-seguros" class="py-16 sm:py-24 bg-transparent scroll-mt-14 overflow-hidden relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <MotionReveal client:visible delay={0.05}>
          <div class="max-w-3xl mx-auto text-center mb-10 sm:mb-12">
            <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-[0.2em] text-sky-300 bg-sky-950/70 border border-sky-400/30 shadow-[0_0_15px_rgba(56,189,248,0.15)] mb-4">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse"></span>
              CATÁLOGO ESPECIALIZADO DE PROTEÇÃO
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-4">
              Proteção sob medida para <span class="italic font-serif text-sky-400">cada momento</span>.
            </h2>
            <p class="text-xs sm:text-sm text-slate-300/85 leading-relaxed max-w-xl mx-auto font-normal">
              Coberturas inteligentes desenhadas para a sua realidade pessoal, patrimonial ou corporativa com as principais seguradoras do país.
            </p>
          </div>
        </MotionReveal>
      </div>

      <MotionReveal client:visible delay={0.1}>
        <SegurosCarousel client:visible />
      </MotionReveal>
    </section>

    <!-- ========================================================================= -->
    <!-- 4. JORNADA DE CONSULTORIA: SPLIT-SCREEN EXECUTIVO (Private Advisory)      -->
    <!-- ========================================================================= -->
    <section id="como-funciona" class="py-20 sm:py-28 scroll-mt-24 lg:scroll-mt-32 bg-[#070B14] border-t border-b border-slate-800/80 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- Coluna Esquerda: Âncora de Autoridade (lg:col-span-5) -->
          <MotionReveal client:visible delay={0.05} className="lg:col-span-5 lg:self-center">
            <div>
              <span class="inline-block text-xs font-medium uppercase tracking-wider text-slate-300 bg-white/5 border border-white/10 px-3.5 py-1 rounded-full mb-4">
                METODOLOGIA CONSULTIVA
              </span>
              <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-white mt-2 mb-6">
                Da análise estratégica à gestão da apólice.
              </h2>
              <p class="text-slate-400 text-sm md:text-base leading-relaxed mb-8">
                Um processo consultivo desenhado para eliminar atritos, proteger o seu patrimônio e garantir que você pague estritamente pelo que faz sentido para a sua realidade.
              </p>

              {/* Diferencial de Agilidade (Badge Sóbrio) */}
              <div class="space-y-3 pt-6 border-t border-slate-800/80">
                <div class="flex items-center gap-2.5 text-xs font-medium text-slate-400">
                  <span class="text-sky-400 text-xs">●</span>
                  <span>Atendimento direto com os consultores titulares</span>
                </div>
